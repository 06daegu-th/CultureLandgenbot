# ---- DB: 기본은 설치가 필요 없는 SQLite 파일. PostgreSQL 은 ./run.sh up (Docker) 이 자동으로 쓴다
#      직접 설치한 PostgreSQL 을 쓰려면: DATABASE_URL=postgresql://quant:비밀번호@localhost:5432/quant
DATABASE_URL=sqlite:///quant_ai.db

# ---- 운영 모드: research | predict | paper | shadow | live | review
QUANT_MODE=paper
QUANT_INITIAL_CASH=10000000
QUANT_ARTIFACTS_DIR=artifacts
QUANT_WATCHLIST=

# ---- 멀티 AI — 무료(한도 있는) 공급자만으로 구성 가능. 키가 있는 것만 자동으로 역할 배정
#   primary(종합) ← Gemini · second(독립 검증) ← NVIDIA · risk(거부권) ← Groq · panel(교차검증) ← Cloudflare Gemma
#   발급처: docs/ENV_KEYS.md · 한도 초과 시 다음 모델로 자동 전환, 모두 소진되면 그 AI 만 기권 (시스템은 계속)
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# 역할 직접 지정 (비우면 자동): primary=gemini,second=nvidia,risk=groq,panel=cloudflare
QUANT_AI_ROLES=
# 모델 목록 (앞에서부터 시도, 쉼표 구분). 비우면 기본값 — 공급자가 모델을 바꾸면 여기서 수정
QUANT_GEMINI_MODELS=
QUANT_GROQ_MODELS=
QUANT_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
QUANT_CLOUDFLARE_MODELS=
# 이 시스템이 스스로 멈추는 하루 호출 수 (비우면 기본: gemini 300 · groq 800 · nvidia 1000 · cloudflare 150)
QUANT_GEMINI_DAILY_LIMIT=
QUANT_GROQ_DAILY_LIMIT=
QUANT_NVIDIA_DAILY_LIMIT=
QUANT_CLOUDFLARE_DAILY_LIMIT=
QUANT_NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
QUANT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- 사이트 채팅 AI (오른쪽 아래 'AI 에게 묻기'). 비우면 설정된 키 중 gemini → claude → groq → nvidia → cloudflare
#      Gemini 는 2.5 Pro(긴 문맥·고품질) → Flash 순서로 자동 전환
QUANT_CHAT_PROVIDER=
QUANT_CHAT_MODELS=

# ---- (선택, 유료) Claude 를 쓰면 primary 는 Claude 가 맡는다
ANTHROPIC_API_KEY=
QUANT_PRIMARY_MODEL=claude-opus-5
QUANT_PRIMARY_EFFORT=high

# ---- LLM 비용·호출 통제 (유료 공급자 비용 상한 / 같은 입력 재사용 시간 — 일봉이라 12시간 권장)
QUANT_LLM_DAILY_BUDGET_USD=20
QUANT_LLM_CACHE_MINUTES=720

# ---- 증권사 (한국투자증권 Open API). 반드시 KIS_ENV=demo(모의투자)로 먼저 검증
QUANT_BROKER=none
KIS_ENV=demo
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=12345678-01
# 절차: docs/KIS_DEMO_RUNBOOK.md

# ---- 전략 / 실제 KRX 데이터
QUANT_STRATEGY=core_satellite
# AI 오버레이 끔 (팩터 코어 100%). AI 기여도가 검증되면 false
QUANT_CORE_ONLY=true
# 코어 전용이어도 AI 는 하루 한 번 판단·채점만 (주문 영향 없음) → 증명 체인 · AI 켜기 판정의 증거가 쌓인다
QUANT_AI_SHADOW=true
# AI 를 켰을 때 범위: full (거부권+긴급청산+위성) / veto (거부권·긴급청산만)
QUANT_AI_OVERLAY=full
# 미국 코어 + AI 가상매매 장부 (무료 일봉, USD, SPY 대비). 끄려면 false
QUANT_US=true
# 검증 사다리: 조건을 통과하면 AI 를 가상 장부(Paper)에 자동으로 쓴다. 실제 돈(소액 Live)은 아래 동의 두 줄이 있어야만.
#   끄면(false) AI 사용은 QUANT_CORE_ONLY 설정만 따른다. 실제 돈 계좌의 AI 는 어느 쪽이든 사다리 '소액 Live' 이상일 때만.
QUANT_AUTO_PROMOTE=true
# 커뮤니티·SNS 분위기 수집 (StockTwits · 네이버 종목토론방, 보유·관심 종목만, 30분마다). 끄려면 false
QUANT_COMMUNITY=true
# 주가 데이터가 이 영업일 수보다 오래되면 자동매매 중단 (0 = 끔)
QUANT_MAX_DATA_AGE_DAYS=5
QUANT_MARCAP_DIR=

# ---- 알림 (https 웹훅만)
QUANT_DISCORD_WEBHOOK=
QUANT_SLACK_WEBHOOK=
QUANT_TELEGRAM_TOKEN=
QUANT_TELEGRAM_CHAT_ID=
QUANT_NOTIFY_LEVEL=info

# ---- 데이터 소스
DART_API_KEY=
FRED_API_KEY=
# 비우면 기본 국내 경제·증권 RSS (연합·한경·매경·구글뉴스). 끄려면 none
QUANT_NEWS_FEEDS=

# ---- 리스크 한도
QUANT_MAX_POSITION_WEIGHT=0.10
QUANT_MAX_GROSS_EXPOSURE=1.0
QUANT_MAX_DAILY_LOSS_PCT=0.02
QUANT_MAX_ORDER_VALUE=5000000
QUANT_MAX_ORDERS_PER_DAY=100
QUANT_MIN_CONFIDENCE=0.55

# ---- 실매매 안전장치 (세 가지 모두 + Shadow 통과 champion 모델이 있어야 Live 가능)
QUANT_LIVE_ENABLED=false
QUANT_LIVE_CONFIRM=
# 실전(KIS_ENV=real) 계좌에만 적용되는 소액 상한
QUANT_LIVE_MAX_CAPITAL=1000000
# 사다리 '소액 Live' 단계의 실전 운용 상한 (원). 이 단계에서는 위 상한과 이 값 중 작은 쪽만 운용
QUANT_LIVE_SMALL_CAPITAL=200000

# ---- 대시보드 (외부 접속 시 필수)
QUANT_WEB_TOKEN=
QUANT_WEB_ALLOWED_HOSTS=
POSTGRES_PASSWORD=change-me

# ---- 운영
QUANT_LOG_JSON=0
